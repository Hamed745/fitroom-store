# Cloudflare Workers AI configuration for FITROOM (server-side only)
# Put real credentials in .env.local, NEVER in this example or GitHub.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Default model is faster and uses less of the free quota.
# For a controlled comparison, switch to @cf/black-forest-labs/flux-2-klein-9b.
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b
