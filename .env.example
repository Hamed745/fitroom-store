# Copy this file to .env.local in the fitroom directory.
# Store credentials only on the server, and never share/commit the key.
IMAGE_API_KEY=
# Fast, capable image editor for first tests. Switch to gpt-image-2.5-sunburst for higher precision.
IMAGE_MODEL=gpt-image-2.5-flare
# Start with medium for testing; use high when satisfied with the pipeline.
IMAGE_QUALITY=medium
